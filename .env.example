# LectureFlow Configuration

# ── Notion ───────────────────────────────────────────────────────────────────
# Create an integration at https://www.notion.so/my-integrations
NOTION_TOKEN=

# The ID of the database you want to export to (found in the URL)
NOTION_DATABASE_ID=

# ── Telegram (opcional) ───────────────────────────────────────────────────────
# Si no se configuran, las notificaciones se deshabilitan silenciosamente.
# 1. Habla con @BotFather en Telegram y crea un bot -> copia el token.
# 2. Envía /start a tu bot, luego visita:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  y copia el "id" de chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
