# Byte-compiled / optimizados / caches
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Variables de entorno y credenciales
.env
*.env
.env.*
.streamlit/secrets.toml

# Entornos virtuales
venv/
venv_*/

# Frontend Vite / React
frontend/node_modules/
frontend/dist/

# Archivos de estado y locks locales
data/
data/.procesando.lock
data/*.tmp
cola_trabajo.json

# Backups del proyecto
backups/

# Archivos pesados y formatos multimedia
*.mp4
*.mkv
*.mov
*.avi
*.mp3
*.m4a
*.wav
*.bak-*
*.pptx

# Directorio de clases: ignorar archivos generados manteniendo los .gitkeep
clases/*
!clases/**/.gitkeep

# Sistema operativo
.DS_Store
Thumbs.db

# Caché de pytest
.pytest_cache/

